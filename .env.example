AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENT_MODEL=gpt-6.1-sol
# AgentRouter requires this client identity on API requests.
AGENTROUTER_USER_AGENT=codex_cli_rs/0.20.0
# PostgreSQL connection string. Keep the real value in .env.
DATABASE_URL=
# The single athlete identity. This is server-only; never send it to the browser.
# A new record with this id is created when the first training entry is logged.
ATHLETE_ID=personal-athlete
# Comma-separated browser origins allowed to call the API. Required in production.
FRONTEND_ORIGINS=http://localhost:5173
# Single-user login password and a long random signing secret (for example: openssl rand -base64 32).
AUTH_PASSWORD=
AUTH_SESSION_SECRET=
# Set true whenever frontend and API are served over HTTPS (required in production).
COOKIE_SECURE=false
# Chat requests permitted per IP within the window. This is in-process, suitable for one instance.
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_MS=60000
# Days of recent training state loaded into agent context.
AGENT_HISTORY_DAYS=30
# Hard cap on assembled prompt size (characters). Knowledge is dropped first.
CONTEXT_MAX_CHARS=200000
# Maximum model ↔ tool rounds per /api/chat request.
AGENT_MAX_TOOL_ROUNDS=5
PORT=3000
