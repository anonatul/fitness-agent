AGENTROUTER_API_KEY=
AGENTROUTER_BASE_URL=https://agentrouter.org/v1
AGENT_MODEL=gpt-6.1-sol
# AgentRouter requires this client identity on API requests.
AGENTROUTER_USER_AGENT=codex_cli_rs/0.20.0
# PostgreSQL connection string. Keep the real value in .env.
DATABASE_URL=
# Optional: pin the single development athlete by database id.
# Leave blank to use the first athlete record.
ATHLETE_ID=
# Days of recent training state loaded into agent context.
AGENT_HISTORY_DAYS=30
# Hard cap on assembled prompt size (characters). Knowledge is dropped first.
CONTEXT_MAX_CHARS=200000
PORT=3000
