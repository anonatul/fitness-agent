{
  "name": "fitness-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Personal AI fitness/training agent backend",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:check": "tsx src/db/check-cli.ts",
    "context:check": "tsx src/context/check.ts",
    "tools:check": "ATHLETE_ID=tool-check-athlete tsx src/agent/toolCheck.ts",
    "training:check": "tsx src/training/trainingCheck.ts",
    "test:eval": "node --env-file=.env --import tsx tests/evaluation/evaluationRunner.ts",
    "test:llm": "node --env-file=.env --import tsx tests/evaluation/llmEvalRunner.ts",
    "test:loop": "node --env-file=.env --import tsx tests/integration/toolLoopLimit.ts",
    "test:chat": "ATHLETE_ID=chat-persistence-check tsx tests/integration/chatPersistence.ts",
    "test:all": "npm run test:eval && npm run context:check && npm run tools:check && npm run test:chat && npm run training:check && npm run build",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "test:frontend": "npm --prefix frontend test",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "openai": "^7.62.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
