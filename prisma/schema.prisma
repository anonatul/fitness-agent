generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum SessionType {
  STRENGTH
  RUN
  RECOVERY
  OTHER
}

enum RunType {
  EASY
  QUALITY
  LONG
  RECOVERY
  OTHER
}

enum ChatMessageRole {
  USER
  AGENT
}
enum PlannedSessionType {
  STRENGTH
  EASY_RUN
  QUALITY_RUN
  LONG_RUN
  RECOVERY
  REST
}
enum PlannedSessionStatus {
  PLANNED
  COMPLETED
  SKIPPED
  MODIFIED
}

model Athlete {
  id              String   @id @default(cuid())
  name            String?
  age             Int?
  sex             String?
  heightCm        Float?
  currentWeightKg Float?
  waistCm         Float?
  restingHr       Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  goals            Goal[]
  trainingSessions TrainingSession[]
  recoveryLogs     RecoveryLog[]
  bodyMetrics      BodyMetric[]
  chatMessages     ChatMessage[]
  trainingPlans    TrainingPlan[]
}

model TrainingPlan {
  id String @id @default(cuid())
  athleteId String
  phaseName String
  weekNumber Int @default(1)
  weekStart DateTime @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  sessions PlannedSession[]
  @@unique([athleteId, weekNumber])
  @@index([athleteId, weekStart])
}

model PlannedSession {
  id String @id @default(cuid())
  trainingPlanId String
  sessionDate DateTime @db.Date
  sessionType PlannedSessionType
  status PlannedSessionStatus @default(PLANNED)
  title String
  notes String?
  targetDistanceKm Float?
  targetDurationMinutes Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  trainingPlan TrainingPlan @relation(fields: [trainingPlanId], references: [id], onDelete: Cascade)
  exercises PlannedExercise[]
  @@unique([trainingPlanId, sessionDate])
  @@index([trainingPlanId, sessionDate])
}

model PlannedExercise {
  id String @id @default(cuid())
  plannedSessionId String
  name String
  orderIndex Int
  sets Int?
  repsMin Int?
  repsMax Int?
  targetRir Int?
  notes String?
  plannedSession PlannedSession @relation(fields: [plannedSessionId], references: [id], onDelete: Cascade)
  @@unique([plannedSessionId, orderIndex])
}

model ChatMessage {
  id        String          @id @default(cuid())
  athleteId String
  role      ChatMessageRole
  text      String
  createdAt DateTime        @default(now())

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId, createdAt])
}

model Goal {
  id          String     @id @default(cuid())
  athleteId   String
  name        String
  priority    Int
  status      GoalStatus @default(ACTIVE)
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId, status])
  @@index([athleteId, priority])
}

model TrainingSession {
  id              String      @id @default(cuid())
  athleteId       String
  sessionType     SessionType
  sessionDate     DateTime
  durationMinutes Int?
  perceivedEffort Int?
  notes           String?
  completed       Boolean     @default(true)

  createdAt DateTime @default(now())

  athlete           Athlete            @relation(fields: [athleteId], references: [id], onDelete: Cascade)
  strengthExercises StrengthExercise[]
  run               Run?

  @@index([athleteId, sessionDate])
  @@index([athleteId, sessionType, sessionDate])
}

model StrengthExercise {
  id                String  @id @default(cuid())
  trainingSessionId String
  name              String
  variation         String?
  orderIndex        Int
  notes             String?

  createdAt DateTime @default(now())

  trainingSession TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
  sets            StrengthSet[]

  @@unique([trainingSessionId, orderIndex])
  @@index([trainingSessionId])
}

model StrengthSet {
  id                 String  @id @default(cuid())
  strengthExerciseId String
  setNumber          Int
  reps               Int?
  rir                Int?
  loadKg             Float?
  assistanceKg       Float?
  durationSeconds    Int?
  notes              String?

  createdAt DateTime @default(now())

  strengthExercise StrengthExercise @relation(fields: [strengthExerciseId], references: [id], onDelete: Cascade)

  @@unique([strengthExerciseId, setNumber])
  @@index([strengthExerciseId])
}

model Run {
  id                      String  @id @default(cuid())
  trainingSessionId       String  @unique
  distanceKm              Float?
  durationSeconds         Int?
  averagePaceSecondsPerKm Int?
  averageHr               Int?
  perceivedEffort         Int?
  runType                 RunType @default(OTHER)
  elevationGainM          Float?
  notes                   String?

  createdAt DateTime @default(now())

  trainingSession TrainingSession @relation(fields: [trainingSessionId], references: [id], onDelete: Cascade)
}

model RecoveryLog {
  id              String   @id @default(cuid())
  athleteId       String
  date            DateTime @db.Date
  sleepHours      Float?
  energyScore     Int?
  sorenessScore   Int?
  motivationScore Int?
  restingHr       Int?
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  /// Unique index covers athlete + date chronological lookups.
  @@unique([athleteId, date])
}

model BodyMetric {
  id        String   @id @default(cuid())
  athleteId String
  date      DateTime @db.Date
  weightKg  Float?
  waistCm   Float?
  restingHr Int?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  /// Unique index covers athlete + date chronological lookups.
  @@unique([athleteId, date])
}
